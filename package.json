{
  "name": "automate-web-builder",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based visual editor for LlamaLab Automate .flo flow files",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:single": "vite build --config vite.singlefile.config.ts && node scripts/build-singlefile.mjs",
    "explain": "tsx tools/explain-flow.ts",
    "blocks": "tsx tools/blocks.ts",
    "build:all": "npm run build && npm run build:single",
    "lint": "tsx tools/lint-flow.ts",
    "audit": "tsx tools/audit-corpus.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
